APP_NAME="LifeLink SL"
APP_ENV=local
APP_URL=http://localhost/lifelink-sl/public
APP_TIMEZONE=Asia/Colombo
APP_KEY=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TIMEOUT_MINUTES=20

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifelink_sl
DB_USER=root
DB_PASS=

# Optional real email delivery. Leave empty in local academic mode.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="LifeLink SL"
BREVO_WEBHOOK_TOKEN=

# Optional real SMS delivery. TextLKDemo + ALLOW_DEV_OTP=true uses local development OTP display.
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=TextLKDemo
ALLOW_DEV_OTP=true

EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
PHONE_OTP_TTL_MINUTES=10
MFA_OTP_TTL_MINUTES=10
EMERGENCY_INVITE_TTL_MINUTES=120
QR_TTL_DAYS=90
